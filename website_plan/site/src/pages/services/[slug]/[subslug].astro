---
import Base from '../../../layouts/Base.astro';
import { SITE } from '../../../data/site.js';
import { services } from '../../../data/loader.js';

export function getStaticPaths() {
  return services.flatMap(s =>
    (s.sub_services ?? []).map(sub => ({ params: { slug: s.slug, subslug: sub.slug } }))
  );
}

const { slug, subslug } = Astro.params;
const service = services.find(s => s.slug === slug);
if (!service) throw new Error(`Service not found: ${slug}`);
const sub = (service.sub_services ?? []).find(s => s.slug === subslug);
if (!sub) throw new Error(`Sub-service not found: ${subslug}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: sub.name,
  description: sub.description,
  provider: { '@type': 'Organization', name: SITE.legal },
  areaServed: { '@type': 'Country', name: 'Philippines' },
  serviceType: service.name,
};
---
<Base title={sub.name} description={sub.description} active="/services/" schema={schema}>

<nav class="pt-5 container-page font-tag font-bold text-[13px] uppercase tracking-tag text-muted" aria-label="Breadcrumb">
  <a href="/" class="text-muted hover:text-tertiary no-underline">Home</a><span class="mx-2 text-border">›</span>
  <a href="/services/" class="text-muted hover:text-tertiary no-underline">Services</a><span class="mx-2 text-border">›</span>
  <a href={`/services/${service.slug}/`} class="text-muted hover:text-tertiary no-underline">{service.name}</a><span class="mx-2 text-border">›</span>
  <span class="text-primary">{sub.name}</span>
</nav>

<section class="py-12 md:py-16">
  <div class="container-page max-w-prose">
    <span class="tag text-tertiary mb-3">Sub-service</span>
    <h1 class="font-display font-extrabold text-primary text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] mb-4">{sub.name}</h1>
    <p class="text-lg text-ink mb-6">{sub.description}</p>
    <a href="/contact/?type=service" class="btn btn-primary">Discuss a {sub.name.toLowerCase()} project</a>
  </div>
</section>

<section class="py-12 md:py-16 bg-surface">
  <div class="container-page max-w-prose">
    <span class="tag text-tertiary mb-3">About {sub.name}</span>
    <h2 class="font-display font-bold text-primary text-[clamp(1.75rem,3.5vw,2.5rem)] mb-4">What ECONARES delivers</h2>
    <p class="text-ink mb-4">ECONARES executes {sub.name.toLowerCase()} projects as part of our PCAB-licensed construction and engineering services. We bring deep Cebu-based field experience, in-house marine logistics for shore and river access, and integrated project management from feasibility through commissioning.</p>
    <p class="text-ink mb-4">All projects are run by ECE Construction Services, a DTI-registered (2019) subsidiary with a Regular Contractor's License from the Philippine Contractors Accreditation Board. Our teams are experienced in working alongside port authorities, plant operators, and EPC primes on both horizontal and vertical scopes.</p>
    <p class="text-ink">For a project-specific scope discussion, request a project meeting with our engineering and operations leads.</p>
  </div>
</section>

<section class="py-12 md:py-16">
  <div class="container-page max-w-prose">
    <span class="tag text-tertiary mb-3">Other {service.name}</span>
    <h2 class="font-display font-bold text-primary text-[clamp(1.75rem,3.5vw,2.5rem)] mb-6">Sub-services in this category</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {service.sub_services.filter(s => s.slug !== sub.slug).map(s => (
        <a href={`/services/${service.slug}/${s.slug}/`} class="block p-4 bg-neutral border border-border rounded-lg hover:border-tertiary no-underline">
          <h3 class="font-display font-bold text-primary text-sm">{s.name}</h3>
          <p class="text-muted text-xs m-0 mt-1">{s.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>

</Base>
