---
import Base from '../layouts/Base.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { SITE } from '../data/site.js';
import { services } from '../data/loader.js';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${SITE.name}`,
  description: `About ${SITE.legal}: SEC-registered Philippine construction and trading company headquartered in Talisay City, Cebu since 2015.`,
};
---
<Base title="About" active="/about/" schema={schema}>

<section class="py-16 md:py-24">
  <div class="container-page max-w-prose">
    <span class="tag text-tertiary mb-3">About ECONARES</span>
    <h1 class="font-display font-extrabold text-primary text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.1] mb-6">A SEC-registered Philippine partner for the inputs and the engineering that build heavy industry.</h1>
    <p class="text-lg text-ink mb-4"><strong>ECE Construction and Resources OPC</strong> (trade name: ECONARES) is a construction and trading company duly registered by the Securities and Exchange Commission under Philippine Laws. We have strong partnerships with local and international companies to provide optimum services and cater best quality products.</p>
    <p class="text-ink mb-4">One of our subsidiaries, <strong>ECE Resources and General Services</strong>, was registered on 2015 under the Department of Trade and Industry. It offers various best quality products in bulk such as local and imported industrial fuels in different specifications — steam coal, metallurgical coke, palm kernel shell, and woodchips — to suffice the huge demand of sugar mills, cement plants, manufacturing plants, and energy-generating power plants in the country. Aside from industrial fuel, it also supplies metallic and non-metallic minerals like construction aggregates, marine sand, boulders/armour rocks, diorite, limestones, chromite, nickel, iron sand, silica sand, greywackes, pozzolan, copper, clinker, quicklime/hydrated lime, gypsum, anhydrite, and other mine mineral resources.</p>
    <p class="text-ink mb-4">In 2019, <strong>ECE Construction Services</strong> was established under the DTI with a Regular Contractor's License from the Philippine Contractors Accreditation Board (PCAB). It handles all types of Construction and Engineering Works in both Horizontal and Vertical Fields such as land development, reclamation, road networks, ports &amp; bridges, shipyards, industrial &amp; manufacturing plant construction, structural steel fabrication &amp; installation, commercial buildings &amp; civil works, electrical works, mechanical / electromechanical engineering, cooling/ventilation, water treatment, deep well &amp; water supply filtration, surveying &amp; designing, and mineral processing plant installation.</p>
  </div>
</section>

<TrustStrip />

<!-- Vision & Mission -->
<section class="py-16 md:py-24 bg-surface">
  <div class="container-page max-w-prose">
    <span class="tag text-tertiary mb-3">Vision &amp; Mission</span>
    <h2 class="font-display font-bold text-primary text-[clamp(1.75rem,3.5vw,2.5rem)] mb-4">High quality construction and engineering services for the country.</h2>
    <p class="text-lg text-ink mb-4">The vision and mission of the company is to provide high quality construction and engineering services to Philippine industry that could help the national economic progress and development in the country.</p>
    <p class="text-lg text-ink mb-4">However, it has always the objective and the will to protect the environment and preserve life while using its resources wisely and prudently for the benefit of all mankind and the many generations to come.</p>
    <div class="mt-8 p-6 bg-neutral border-l-4 border-tertiary rounded">
      <p class="text-muted m-0"><strong>ECE</strong> stands for: <em>Excellent products &amp; services · Corporate social and environmental responsibility · Economic development share</em>.</p>
    </div>
  </div>
</section>

<!-- Organization -->
<section class="py-16 md:py-24">
  <div class="container-page">
    <div class="text-center max-w-[720px] mx-auto mb-12">
      <span class="tag text-tertiary mb-3">Organization</span>
      <h2 class="font-display font-bold text-primary text-[clamp(1.75rem,3.5vw,2.5rem)] mb-4">Five departments, one accountable structure</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {[
        { t: 'Admin & HR', d: 'HR, legal/liaison, safety, company nurse' },
        { t: 'Operations', d: 'Engineering/planning, QS/QC, surveying, construction management' },
        { t: 'Accounting & Finance', d: 'Payables, billing & collection, tax & benefits, audit' },
        { t: 'Sales & Marketing', d: 'Mine minerals, fuel, construction, shipping & equipment rental' },
        { t: 'Supply Chain', d: 'Logistics, maintenance, drivers/operators, procurement, warehouse' },
      ].map(dept => (
        <div class="p-5 bg-neutral border border-border rounded-lg">
          <h3 class="font-display font-bold text-primary text-base mb-2">{dept.t}</h3>
          <p class="text-muted text-sm m-0">{dept.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Subsidiaries & Credentials -->
<section class="py-16 md:py-24 bg-surface">
  <div class="container-page">
    <div class="text-center max-w-[720px] mx-auto mb-12">
      <span class="tag text-tertiary mb-3">Subsidiaries &amp; Credentials</span>
      <h2 class="font-display font-bold text-primary text-[clamp(1.75rem,3.5vw,2.5rem)] mb-4">Three registered entities, one accountable partner</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-neutral border border-border rounded-lg">
        <span class="tag text-tertiary mb-3">Subsidiary · 2015</span>
        <h3 class="font-display font-bold text-primary text-lg mb-2">ECE Resources and General Services</h3>
        <p class="text-muted text-[15px]">DTI-registered trading arm for industrial fuels and metallic &amp; non-metallic minerals.</p>
      </div>
      <div class="p-6 bg-neutral border border-border rounded-lg">
        <span class="tag text-tertiary mb-3">Subsidiary · 2019</span>
        <h3 class="font-display font-bold text-primary text-lg mb-2">ECE Construction Services</h3>
        <p class="text-muted text-[15px]">DTI-registered construction arm with Regular PCAB Contractor's License for horizontal and vertical works.</p>
      </div>
      <div class="p-6 bg-neutral border border-border rounded-lg">
        <span class="tag text-tertiary mb-3">Parent</span>
        <h3 class="font-display font-bold text-primary text-lg mb-2">ECE Construction and Resources OPC</h3>
        <p class="text-muted text-[15px]">SEC-registered parent company. Trade name: ECONARES.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-primary text-neutral py-20 text-center">
  <div class="container-page">
    <h2 class="font-display font-bold text-neutral text-[clamp(1.75rem,3.5vw,2.5rem)] mb-4">Ready to work with us?</h2>
    <p class="text-sky text-lg max-w-[600px] mx-auto mb-8">Send us your spec, your tonnage, or your project location. We reply within 48 hours.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/contact/?type=product" class="btn btn-primary">Request Fuel Quote</a>
      <a href="/contact/?type=service" class="btn !bg-transparent !text-neutral !border-2 !border-neutral hover:!bg-neutral hover:!text-primary">Discuss a Project</a>
    </div>
  </div>
</section>

</Base>
