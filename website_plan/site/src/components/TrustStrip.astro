---
// src/components/TrustStrip.astro — the SEC/DTI/PCAB credential band
import { SITE } from '../data/site.js';
---
<div class="bg-primary py-5">
  <div class="container-page">
    <ul class="flex flex-wrap gap-3 justify-center items-center" aria-label="Credentials">
      {SITE.credentials.map(c => (
        <li class="inline-flex items-center gap-2 px-4 py-1.5 border border-green text-green font-tag font-bold text-[13px] uppercase tracking-tag rounded-full whitespace-nowrap">
          <span class="text-green font-extrabold" aria-hidden="true">✓</span>
          {c}
        </li>
      ))}
    </ul>
  </div>
</div>
