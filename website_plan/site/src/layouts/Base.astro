---
// src/layouts/Base.astro — root layout with SEO, fonts, structured data
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site.js';

const {
  title,
  description = SITE.description,
  active = '',
  schemaType = 'WebPage',
  schema = null,
  canonical = null,
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — Industrial Fuels, Minerals & Construction From Cebu, Philippines`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();

// Default organization schema (always emitted on every page)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legal,
  alternateName: SITE.name,
  url: SITE.url,
  logo: new URL('/logo.png', SITE.url).toString(),
  description: SITE.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: 'Talisay City',
    addressRegion: 'Cebu',
    postalCode: '6045',
    addressCountry: 'PH',
  },
  contactPoint: [{
    '@type': 'ContactPoint',
    telephone: SITE.phone,
    email: SITE.email,
    contactType: 'sales',
    areaServed: 'PH',
    availableLanguage: ['en', 'fil'],
  }],
  foundingDate: String(SITE.founded),
  sameAs: [SITE.social.linkedin],
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}#local`,
  name: SITE.legal,
  image: new URL('/logo.png', SITE.url).toString(),
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: 'Talisay City',
    addressRegion: 'Cebu',
    postalCode: '6045',
    addressCountry: 'PH',
  },
  url: SITE.url,
  priceRange: '$$',
};

const finalSchema = schema ?? { '@context': 'https://schema.org', '@type': schemaType };
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:type" content="website">
<meta property="og:image" content={ogImageUrl}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:locale" content="en_PH">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600;700&family=Barlow+Condensed:wght@700&family=Charter:wght@400;500;700&display=swap">

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
{!schema && <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />}

<meta name="theme-color" content="#002A54">
</head>
<body>
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-primary focus:text-neutral focus:px-3 focus:py-2 focus:rounded">Skip to content</a>
<Header active={active} />
<main id="main">
  <slot />
</main>
<Footer />
</body>
</html>
