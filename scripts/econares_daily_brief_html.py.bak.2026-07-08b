        parts.append('<tr><td style="padding:10px 12px;border-bottom:1px solid #eee;vertical-align:top;">')
        parts.append('<span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:' + c['color'] + ';margin-right:5px;vertical-align:middle;"></span>')
        parts.append('<strong style="color:' + c['color'] + ';font-size:12px;">' + c['name'] + '</strong></td>')
        parts.append('<td style="padding:10px 12px;border-bottom:1px solid #eee;text-align:center;font-weight:bold;font-size:12px;color:' + c['color'] + ';">' + c['unit'] + '</td>')
        parts.append('<td style="padding:10px 12px;border-bottom:1px solid #eee;text-align:center;font-size:11px;color:#666;">' + c['ph'] + '</td>')
