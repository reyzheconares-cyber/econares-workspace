def _load_night_summary():
    """Read last night's staging files. Returns dict with counts (or empty)."""
    out = {
        "research": None, "dedup": None, "classify": None,
        "crm_enrichment": None, "deal_staleness": None, "feed_targets": None,
        "trade_news": None, "hiring_signal": None, "equipment_monitor": None,
        "ran": False,
    }
    # Core night pipeline (lead-gen research)
    for stage in ("research", "dedup", "classify"):
        s = latest_staging(f"nightly_{stage}")
        if s and s.get("data"):
            out[stage] = s["data"].get("summary", {})
            out["ran"] = True
    # CRM enrichment + deal-staleness + target-feed (added 2026-07-05)
    for stage in ("crm_enrichment", "deal_staleness", "feed_nightly_targets"):
        s = latest_staging(stage)
        if s and s.get("data"):
            out[stage.replace("crm_enrichment", "crm_enrichment").replace(
                "deal_staleness", "deal_staleness").replace(
                "feed_nightly_targets", "feed_targets")] = s["data"].get("summary", {})
            out["ran"] = True
    # Idle lead-gen signal scrapers (added 2026-07-08 — trade news / hiring / equipment)
    for stage in ("trade_news_scraper", "hiring_signal_scraper", "equipment_monitor"):
        s = latest_staging(stage)
        if s and s.get("data"):
            out[stage] = s["data"].get("summary", {})  # full key e.g. "trade_news_scraper"
            out["ran"] = True
            # Also mirror to short key for renderer lookup (matches the crm_enrichment/deal_staleness pattern)
            short_key = stage.replace("_scraper", "")
            out[short_key] = s["data"].get("summary", {})
    return out


def _night_pipeline_line():
    """One-line summary of last night's pipeline, for stdout / Obsidian."""
    ns = _load_night_summary()
    if not ns["ran"]:
        return "NIGHT PIPELINE: no runs in staging (idle)"
    parts = []
    if ns["research"]:
        r = ns["research"]
        parts.append(
            f"research: {r.get('total',0)} targets, "
            f"{r.get('parent_inbox_routed',0)} parent-inbox, "
            f"{r.get('smtp_ok',0)} SMTP-OK, "
            f"{r.get('mx_dead',0)} MX-dead"
        )
    if ns["dedup"]:
        d = ns["dedup"]
        parts.append(f"dedup: {d.get('new',0)} new, {d.get('duplicates',0)} dups")
    if ns["classify"]:
        c = ns["classify"]
        parts.append(
            f"classify: hot={c.get('hot',0)} warm={c.get('warm',0)} "
            f"monitor={c.get('monitor',0)} skip={c.get('skip',0)}"
        )
    # CRM enrichment summary (weekly, Sun 23:00)
    if ns.get("crm_enrichment"):
        e = ns["crm_enrichment"]
        parts.append(
            f"crm: {e.get('total_contacts',0)} contacts, "
            f"{e.get('no_email',0)} no-email, "
            f"{e.get('no_phone',0)} no-phone, "
            f"{e.get('stale_over_180d',0)} stale>180d"
        )
    # Deal staleness summary (weekly, Mon 01:30)
    if ns.get("deal_staleness"):
        d = ns["deal_staleness"]
        parts.append(
            f"deals: {d.get('open_deals',0)} open, "
            f"{d.get('stale_over_14d',0)} stale>14d, "
            f"{d.get('stuck_early_over_30d',0)} stuck-early>30d"
        )
    # Target feed summary (weekdays 18:00)
    if ns.get("feed_targets"):
        f_ = ns["feed_targets"]
        parts.append(
            f"targets: fed {f_.get('written',0)} to research queue"
        )
    # Idle lead-gen signal scrapers (added 2026-07-08)
    if ns.get("trade_news"):
        e = ns["trade_news"]
        parts.append(
            f"news: {e.get('new_buyer_count',0)} new-buyer signals, {e.get('total_results',0)} articles"
        )
    if ns.get("hiring_signal"):
        e = ns["hiring_signal"]
        parts.append(
            f"hiring: {e.get('new_count',0)} new procurement hires, {e.get('expansion_count',0)} expansions"
        )
    if ns.get("equipment_monitor"):
        e = ns["equipment_monitor"]
        parts.append(
            f"equipment: {e.get('classified',0)} orders, {e.get('buyers',0)} new buyers flagged"
        )
    return "NIGHT PIPELINE: " + " | ".join(parts) if parts else "NIGHT PIPELINE: silent"

TOKENS = {'gmail_app_pw': '', 'hs_token': '', 'tg_token': ''}
with open(os.path.expanduser('~/.hermes/.env')) as f:
    for raw in f:
        # Tolerate both 'export KEY=val' and bare 'KEY=val' styles in .env.
        # Some Hermes-installed env lines (e.g. TELEGRAM_BOT_TOKEN) drop the
        # 'export' prefix, so we strip it instead of relying on startswith.
        line = raw.strip()
        if line.startswith('export '):
            line = line[len('export '):].lstrip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        key, _, value = line.partition('=')
        value = value.strip().strip('"').strip("'")
        if not value:
            continue
        if key == 'GMAIL_APP_PASSWORD':
            TOKENS['gmail_app_pw'] = value
        elif key == 'HUBSPOT_ACCESS_TOKEN':
            # Token may contain special chars; prefer quoted extraction if present
            mq = re.search(r'"([^"]+)"', raw)
            TOKENS['hs_token'] = mq.group(1) if mq else value
        elif key == 'TELEGRAM_BOT_TOKEN':
            TOKENS['tg_token'] = value

HS_TOKEN = TOKENS.get('hs_token', '')
GMAIL_FROM = 'rzh24.econares@gmail.com'
